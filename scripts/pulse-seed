#!/usr/bin/env bash
# pulse-seed: keep the Knowledge Pulse ring moving on a LOCAL dev database.
#
# Inserts fake read, write, link and (rarely) feed-post events at random
# intervals, using the real resource ids, members and feeds of one team, so
# GET /api/v1/{team_id}/knowledge-pulse has something to show when the team is
# quiet. LOCAL DEV ONLY: it writes straight into the dev database and never
# cleans up after itself; never point it at a database you care about.
#
# Usage:
#   scripts/pulse-seed [--team <slug-or-uuid>] [--count N] [--min S] [--max S] [--dry-run]
#
#   --team     team to seed (default: the team with the most resources)
#   --count    number of events, 0 = run until Ctrl-C (default 0)
#   --min/max  random pause between bursts, in seconds (default 0.5 / 4)
#   --dry-run  print the SQL instead of running it
#
# Environment:
#   DATABASE_URL  default postgres://vibexp_app:local_password@localhost:5432/vibexp_io?sslmode=disable
#                 (the dev Postgres from backend/docker-compose.yml)
#
# Needs psql on PATH; falls back to `docker exec backend-postgres-1 psql`.
set -euo pipefail

DATABASE_URL="${DATABASE_URL:-postgres://vibexp_app:local_password@localhost:5432/vibexp_io?sslmode=disable}"
TEAM=""
COUNT=0
MIN_SLEEP=0.5
MAX_SLEEP=4
DRY_RUN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --team) TEAM="$2"; shift 2 ;;
    --count) COUNT="$2"; shift 2 ;;
    --min) MIN_SLEEP="$2"; shift 2 ;;
    --max) MAX_SLEEP="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

if command -v psql >/dev/null 2>&1; then
  q() { psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -qAtX -F '|' -c "$1"; }
else
  q() { docker exec -i backend-postgres-1 psql -U vibexp_app -d vibexp_io -v ON_ERROR_STOP=1 -qAtX -F '|' -c "$1"; }
fi

# Run a write, or print it with --dry-run.
w() {
  if [[ $DRY_RUN -eq 1 ]]; then echo "$1;"; else q "$1" >/dev/null; fi
}

# --- Resolve the team -------------------------------------------------------
if [[ -z "$TEAM" ]]; then
  TEAM_ID=$(q "SELECT t.id FROM teams t
    ORDER BY (SELECT COUNT(*) FROM prompts    WHERE team_id = t.id)
           + (SELECT COUNT(*) FROM memories   WHERE team_id = t.id)
           + (SELECT COUNT(*) FROM artifacts  WHERE team_id = t.id)
           + (SELECT COUNT(*) FROM blueprints WHERE team_id = t.id) DESC
    LIMIT 1")
else
  TEAM_ID=$(q "SELECT id FROM teams WHERE id::text = '${TEAM//\'/}' OR slug = '${TEAM//\'/}' LIMIT 1")
fi
[[ -n "$TEAM_ID" ]] || { echo "team not found: ${TEAM:-<any>}" >&2; exit 1; }

# --- Load the team's resources, members and feeds -----------------------------
mapfile -t RESOURCES < <(q "
  SELECT 'prompt',    id, project_id FROM prompts    WHERE team_id = '$TEAM_ID' UNION ALL
  SELECT 'memory',    id, project_id FROM memories   WHERE team_id = '$TEAM_ID' UNION ALL
  SELECT 'artifact',  id, project_id FROM artifacts  WHERE team_id = '$TEAM_ID' UNION ALL
  SELECT 'blueprint', id, project_id FROM blueprints WHERE team_id = '$TEAM_ID'")
mapfile -t MEMBERS < <(q "SELECT user_id FROM team_members WHERE team_id = '$TEAM_ID'
                          UNION SELECT owner_id FROM teams WHERE id = '$TEAM_ID'")
mapfile -t FEEDS < <(q "SELECT id FROM feeds WHERE team_id = '$TEAM_ID'")

[[ ${#RESOURCES[@]} -gt 0 ]] || { echo "team $TEAM_ID has no prompts, memories, artifacts or blueprints" >&2; exit 1; }
[[ ${#MEMBERS[@]} -gt 0 ]] || { echo "team $TEAM_ID has no members" >&2; exit 1; }

echo "pulse-seed: team $TEAM_ID, ${#RESOURCES[@]} resources, ${#MEMBERS[@]} members, ${#FEEDS[@]} feeds" >&2

AGENTS=("claude-code/2.0.14" "Cursor/1.7.3 (darwin)" "codex-cli/0.46.0" "vibexp-cli/1.4.0" "Windsurf/1.12")
ASSISTANTS=("claude-code" "cursor" "codex" "windsurf")
MCP_SOURCES=("mcp" "mcp" "mcp" "cli" "api")
RELATIONS=("built-from" "explained-by" "governed-by" "supersedes")
POSTS=("Wrapped up the auth refactor" "Captured lessons from the flaky test hunt"
       "Consolidated three deploy memories into one" "Linked the runbook to its blueprint"
       "Shipped the pulse demo backend")

pick() { local -n arr=$1; echo "${arr[RANDOM % ${#arr[@]}]}"; }
resource() { IFS='|' read -r R_TYPE R_ID R_PROJECT <<<"$(pick RESOURCES)"; }

seed_read() {
  resource
  local user; user=$(pick MEMBERS)
  if (( RANDOM % 4 == 0 )); then
    w "INSERT INTO resource_access_events (team_id, user_id, resource_type, resource_id, source)
       VALUES ('$TEAM_ID', '$user', '$R_TYPE', '$R_ID', 'web')"
    echo "read  $R_TYPE $R_ID (web)"
  else
    local src ua; src=$(pick MCP_SOURCES); ua=$(pick AGENTS)
    w "INSERT INTO resource_access_events (team_id, user_id, resource_type, resource_id, source, user_agent)
       VALUES ('$TEAM_ID', '$user', '$R_TYPE', '$R_ID', '$src', '$ua')"
    echo "read  $R_TYPE $R_ID ($src, $ua)"
  fi
}

seed_write() {
  resource
  local user; user=$(pick MEMBERS)
  # Only updates: the table allows one create event per resource, and the
  # resources already exist.
  if (( RANDOM % 4 == 0 )); then
    w "INSERT INTO resource_write_events (team_id, project_id, user_id, resource_type, resource_id, action, source)
       VALUES ('$TEAM_ID', '$R_PROJECT', '$user', '$R_TYPE', '$R_ID', 'update', 'web')"
    echo "write $R_TYPE $R_ID (web)"
  else
    local a; a=$(pick ASSISTANTS)
    w "INSERT INTO resource_write_events (team_id, project_id, user_id, resource_type, resource_id, action, source, assistant_name)
       VALUES ('$TEAM_ID', '$R_PROJECT', '$user', '$R_TYPE', '$R_ID', 'update', 'mcp', '$a')"
    echo "write $R_TYPE $R_ID (mcp, $a)"
  fi
}

seed_link() {
  resource
  local from_type=$R_TYPE from_id=$R_ID project=$R_PROJECT tries=0
  # Relations are project-scoped: find a different resource in the same project.
  while (( tries++ < 20 )); do
    resource
    [[ "$R_PROJECT" == "$project" && "$R_ID" != "$from_id" ]] && break
  done
  if [[ "$R_PROJECT" != "$project" || "$R_ID" == "$from_id" ]]; then
    seed_read; return
  fi
  local rel origin user; rel=$(pick RELATIONS); user=$(pick MEMBERS)
  origin=$([[ $((RANDOM % 3)) -eq 0 ]] && echo human || echo ai)
  w "INSERT INTO resource_relations (team_id, project_id, from_type, from_id, to_type, to_id, relation_type, origin, status, created_by)
     VALUES ('$TEAM_ID', '$project', '$from_type', '$from_id', '$R_TYPE', '$R_ID', '$rel', '$origin',
             '$([[ $origin == human ]] && echo confirmed || echo suggested)', '$user')
     ON CONFLICT DO NOTHING"
  echo "link  $from_type $from_id -[$rel]-> $R_TYPE $R_ID ($origin)"
}

seed_feed() {
  if [[ ${#FEEDS[@]} -eq 0 ]]; then seed_read; return; fi
  local feed user title a; feed=$(pick FEEDS); user=$(pick MEMBERS); title=$(pick POSTS); a=$(pick ASSISTANTS)
  w "INSERT INTO feed_items (team_id, feed_id, title, content, excerpt, ai_assistant_name, posted_by_user_id)
     VALUES ('$TEAM_ID', '$feed', '$title', '$title (pulse-seed)', '$title', '$a', '$user')"
  echo "post  \"$title\" ($a)"
}

seed_one() {
  local roll=$((RANDOM % 100))
  if   (( roll < 60 )); then seed_read
  elif (( roll < 82 )); then seed_write
  elif (( roll < 97 )); then seed_link
  else seed_feed
  fi
}

trap 'echo; echo "pulse-seed: stopped after $n events" >&2; exit 0' INT TERM
n=0
while (( COUNT == 0 || n < COUNT )); do
  # Bursts of 1-3 events read like a real agent session better than a metronome.
  burst=$((1 + RANDOM % 3))
  for ((i = 0; i < burst && (COUNT == 0 || n < COUNT); i++)); do
    seed_one
    n=$((n + 1))
  done
  (( COUNT == 0 || n < COUNT )) || break
  sleep "$(awk -v min="$MIN_SLEEP" -v max="$MAX_SLEEP" -v r="$RANDOM" 'BEGIN { printf "%.2f", min + (max - min) * r / 32767 }')"
done
echo "pulse-seed: done, $n events" >&2
